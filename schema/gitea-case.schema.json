{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "operation_id", "request", "initial_issues", "scenario", "expected", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "request": {"type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": {
      "title": {"type": "string", "minLength": 1, "maxLength": 200}, "body": {"type": "string", "maxLength": 4000}
    }},
    "initial_issues": {"type": "array", "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false, "required": ["operation_id", "title", "body", "state"], "properties": {
        "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200}, "body": {"type": "string", "maxLength": 4000},
        "state": {"enum": ["open", "closed"]}
      }
    }},
    "scenario": {"enum": ["create", "duplicate", "close"]},
    "expected": {"type": "object", "additionalProperties": false, "required": ["count", "state"], "properties": {
      "count": {"const": 1}, "state": {"enum": ["open", "closed"]}
    }},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_tool_calls", "page_size", "max_pages"], "properties": {
      "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 4},
      "page_size": {"type": "integer", "minimum": 1, "maximum": 50},
      "max_pages": {"type": "integer", "minimum": 1, "maximum": 20}
    }}
  }
}
